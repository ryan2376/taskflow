# ============================================================================
#  .env.example  —  template for local environment variables.
#
#  HOW TO USE:  copy this file to ".env" (which is git-ignored) and adjust values.
#      cp .env.example .env       (macOS/Linux)
#      Copy-Item .env.example .env  (PowerShell)
#
#  docker-compose.yml reads .env automatically. The Spring app reads these same
#  variables when you export them into your shell before running ./mvnw.
#
#  NEVER commit a real .env. Real secrets live only in your machine / the
#  deployment platform's environment settings.
# ============================================================================

# --- Database (used by both docker-compose and the Spring 'dev' profile) ---
DB_NAME=taskflow
DB_USERNAME=taskflow
DB_PASSWORD=taskflow
# Host port for the Dockerized Postgres. 5433 avoids clashing with a native
# PostgreSQL install that may already own 5432.
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/taskflow

# --- pgAdmin web UI (http://localhost:5050) ---
# pgAdmin rejects reserved TLDs (e.g. ".local") as invalid emails.
PGADMIN_EMAIL=admin@taskflow.com
PGADMIN_PASSWORD=admin

# --- JWT signing (Phase 4 onward) ---
# For production, generate a long random value, e.g.:
#   openssl rand -base64 48
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789-abcdefghij
JWT_EXPIRATION_MS=86400000
